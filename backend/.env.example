# 本地开发可复制为 .env，Docker/部署环境优先使用真实环境变量注入。

# 应用基础配置
APP_NAME=DevDoc RAG API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Web 服务运行配置
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://offer-copilot-frontend.vercel.app
BACKEND_CORS_ORIGIN_REGEX=

# 数据库与缓存配置
# DATABASE_URL 供 API / Celery worker 使用，必须是 asyncpg 版本
# ALEMBIC_DATABASE_URL 供迁移使用，保持 psycopg2 这类同步驱动
# 本地直连宿主机（非 Docker）用 5433；Docker 容器内走 compose 网络用 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/offercopilot
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/offercopilot

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 鉴权配置
# 必须替换成你自己生成的随机密钥；不要在开发/生产环境复用同一个值，也不要提交真实密钥。
# 可用命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:3000/auth/reset-password

# SMTP 邮件配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM=
MAIL_FROM_NAME=DevDoc RAG

# Cookie 配置
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth/refresh-token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# Celery（broker 和 result backend 都用 Redis，DB=1 与主 Redis 隔离）
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# OpenAI（embedding: text-embedding-3-small，LLM: gpt-4o）
OPENAI_API_KEY=

# 混合检索召回数量
RAG_VECTOR_TOP_K=20
RAG_FTS_TOP_K=20

# RAG 相关性阈值。设为 0 可关闭 rerank 分数过滤；过高会增加拒答率。
RAG_MIN_RERANK_SCORE=0.15

# Query rewrite：检索前将用户问题改写为 standalone query
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODEL=gpt-4o-mini

# RAG telemetry：输出结构化日志，记录召回、重排、引用与耗时
RAG_TELEMETRY_ENABLED=true

# RAG debug：输出详细调试信息
RAG_DEBUG_ENABLED=false

# Firecrawl（URL 爬取 → Markdown）
FIRECRAWL_API_KEY=

# AWS S3（用户上传 PDF 存储）
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
